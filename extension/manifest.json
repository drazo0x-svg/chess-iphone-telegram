{
  "manifest_version": 3,
  "name": "Chess Training — iPhone Stockfish",
  "version": "3.0.2",
  "description": "Analyse automatique des positions d'entraînement via Stockfish sur iPhone, avec flèche sur l'échiquier.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}